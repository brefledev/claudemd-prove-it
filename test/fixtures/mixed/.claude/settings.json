{
  "permissions": {
    "deny": ["Edit(./protected/**)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Task|Agent|Workflow",
        "hooks": [
          { "type": "command", "command": "node scripts/subagent-guard.mjs" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node scripts/shell-check.mjs" }
        ]
      }
    ]
  }
}
